+bool NavEKF3_core::getHeightInnovation(float &innovation, float &test_ratio, uint32_t &acceptance_age_ms) const
+{
+    innovation = innovVelPos[5];
+    test_ratio = hgtTestRatio;
+    acceptance_age_ms = lastHgtPassTime_ms ? imuSampleTime_ms - lastHgtPassTime_ms : UINT32_MAX;
+    return statesInitialised && lastHgtPassTime_ms != 0;
+}
